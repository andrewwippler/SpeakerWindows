@let(activeQuery = query || '')
<div class="col-12">
  <details>
    <summary>
      <span style="display: flex; align-items: center; gap: var(--space-3);">
        @if(selectable)
          <input
            type="checkbox"
            :value="'{{ illustration.id }}'"
            x-model="selected"
            x-show="selectable"
            @click.stop
          />
        @end
        @if(illustration.private)
          <span class="badge" data-variant="warning">Private</span>
        @end
        {{{ highlight(illustration.title, activeQuery) }}}
      </span>
    </summary>
    <p class="p-4">{{{ highlight(excerpt(illustration.content, 250), activeQuery) }}}</p>
    <p><a href="/illustrations/{{ illustration.id }}">View the full illustration</a></p>
  </details>
</div>