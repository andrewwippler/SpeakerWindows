@layout()
<h2>Invitations</h2>

@flashMessage('success')
  <div role="alert" data-variant="success">
    {{ $message }}
  </div>
@end

@flashMessage('error')
  <div role="alert" data-variant="error">
    {{ $message }}
  </div>
@end

@if(invitations.length)
  <div style="display: flex; flex-direction: column; gap: var(--space-4);">
    @each(invitation in invitations)
      <article class="card" id="invitation-{{ invitation.id }}">
        <header>
          <h4>{{ invitation.teamName || invitation.team?.name || 'Team' }}</h4>
          <p>Invited by {{ invitation.invitedBy?.fullName || 'someone' }}</p>
          <p>{{ invitation.email }}</p>
        </header>
        <footer>
          <button
            hx-patch="/api/invitations/{{ invitation.id }}/accept"
            hx-target="#invitation-{{ invitation.id }}"
            hx-swap="outerHTML"
            data-variant="secondary"
          >
            Accept
          </button>
          <button
            hx-delete="/api/invitations/{{ invitation.id }}/decline"
            hx-target="#invitation-{{ invitation.id }}"
            hx-swap="outerHTML"
            data-variant="danger"
          >
            Decline
          </button>
        </footer>
      </article>
    @endeach
  </div>
@else
  <p>No pending invitations.</p>
@end
@end
