@layout()
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-sky-800 dark:text-sky-200">Recently Viewed</h1>
  </div>

  @if(recentlyViewed && recentlyViewed.length)
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      @each(illustration in recentlyViewed)
        <a
          href="/illustrations/{{ illustration.id }}"
          class="block rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4 shadow-sm hover:shadow-md transition-shadow"
        >
          @if(illustration.uploads && illustration.uploads.length)
            <div class="mb-3 aspect-video overflow-hidden rounded-md bg-gray-100 dark:bg-gray-700">
              <img
                src="/uploads/{{ illustration.uploads[0].name }}"
                alt="{{ illustration.title }}"
                class="h-full w-full object-cover"
              />
            </div>
          @endif

          <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 truncate">
            {{ illustration.title }}
          </h2>

          @if(illustration.author)
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
              {{ illustration.author }}
            </p>
          @endif

          @if(illustration.tags && illustration.tags.length)
            <div class="mt-2 flex flex-wrap gap-1">
              @each(tag in illustration.tags)
                <ot-tag>{{ tag.name }}</ot-tag>
              @end
            </div>
          @endif
        </a>
      @end
    </div>
  @else
    <p class="text-gray-500 dark:text-gray-400 text-sm">No recently viewed illustrations.</p>
  @endif
@end
