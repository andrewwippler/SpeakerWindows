@layout()
<h2>Recently Viewed</h2>
@if(recentlyViewed && recentlyViewed.length)
    <div class="container">
      <div class="row">
        @each(illustration in recentlyViewed)
          @include('components/illustration_card')
        @end
      </div>
    </div>
@else
  <p>No recently viewed illustrations.</p>
@end
@end
