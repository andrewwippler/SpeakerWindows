@layout()

<div style="margin-bottom: var(--space-4);">
  <a href="/illustrations/{{ illustration.id }}">&larr; Back to Illustration</a>
</div>

<h2>Edit Illustration</h2>

@flashMessage('error')
<div role="alert" data-variant="error">
  {{ $message }}
</div>
@end

@flashMessage('success')
<div role="alert" data-variant="success">
  {{ $message }}
</div>
@end

<form action="/illustrations/{{ illustration.id }}" method="POST">
  <input type="hidden" name="_csrf" value="{{ csrfToken || '' }}" />
  <input type="hidden" name="_method" value="PUT" />
  <label data-field>
    Title
    <input type="text" name="title" value="{{ illustration.title || '' }}" required />
  </label>
  <label data-field>
    Author
    <input type="text" name="author" value="{{ illustration.author || '' }}" />
  </label>
  <label data-field>
    Source
    <input type="text" name="source" value="{{ illustration.source || '' }}" />
  </label>
  <label data-field>
    Tags
    <ot-taginput value="{{ illustration.tags ? illustration.tags.map(t => t.name).join(', ') : '' }}">
      <input name="tags" list="tag-list" placeholder="Add tags..." oninput="tagInputAutoComplete(this)" />
      <datalist id="tag-list">
        @each(tag in tags)
        <option value="{{ tag.name }}">
          @end
      </datalist>
    </ot-taginput>
  </label>
  <label data-field>
    Content
    <textarea name="content" rows="12">{{ illustration.content || '' }}</textarea>
  </label>
  <div style="display: flex; gap: var(--space-3); margin-top: var(--space-4);">
    <button type="submit">Save</button>
    <a href="/illustrations/{{ illustration.id }}" class="outline">Cancel</a>
  </div>
</form>
<script>
  const allTags = {{{ JSON.stringify(tags.map(t => t.name)) }}};

  function tagInputAutoComplete(el) {
    if (!el.list) return;

    const filtered = allTags.filter(name =>
      name.toLowerCase().startsWith(el.value.toLowerCase())
    );

    el.list.replaceChildren(...filtered.map(name => {
      const option = document.createElement('option');
      option.value = name;
      return option;
    }));
  }

  // Handle Undo functionality for <ot-taginput>
  document.addEventListener('DOMContentLoaded', () => {
    const tagInput = document.querySelector('ot-taginput');
    const inputField = tagInput?.querySelector('input');
    if (!tagInput || !inputField) return;

    // Use capture phase (true) on the parent <ot-taginput> element
    tagInput.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && inputField.value === '') {
        e.preventDefault();
        e.stopImmediatePropagation();
      }
    }, true);
  });
</script>
@end