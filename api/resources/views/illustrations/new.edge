@layout()
<div style="margin-bottom: var(--space-4);">
  <a href="/illustrations">&larr; Back to Illustrations</a>
</div>

<article class="card">
  <header>
    <h3>New Illustration</h3>
  </header>

  <form action="/illustrations" method="POST" class="container" enctype="multipart/form-data">
    {{ csrfField() }}

    <div class="row">
      <div class="col-12">
        <label data-field>
          <input type="checkbox" name="private" id="private" />
          <span>Private/Personal illustration</span>
        </label>
      </div>
      <div class="col-6">
        <label data-field>
          Title
          <input type="text" name="title" required />
        </label>
      </div>
      <div class="col-6">
        <label data-field>
          Author
          <input type="text" name="author" />
        </label>
      </div>
    </div>

    <div class="row">
      <div class="col-12">
        <label data-field>
          Source
          <input type="text" name="source" />
        </label>
      </div>
    </div>

    <div class="row">
      <div class="col-12">
        <label data-field>
          Illustration Image(s)
          <ot-upload>
            <input type="file" name="illustration_image" multiple accept=".png,.jpg,.jpeg,.gif,.pdf" hidden />
            <button type="button" class="ghost">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/images/feather-sprite.svg#upload"></use></svg>Choose files
            </button>
            <div data-files>
              <small data-hint>Drop files here or click to choose (PNG, JPG, GIF, PDF &mdash; max 20MB each)</small>
            </div>
          </ot-upload>
        </label>
      </div>
    </div>

    <div class="row">
      <div class="col-12">
        <label data-field>
          Tags
          <ot-taginput>
            <input name="tags" list="tag-list" placeholder="Add tags..." oninput="tagInputAutoComplete(this)" />
            <datalist id="tag-list">
              @each(tag in tags)
                <option value="{{ tag.name }}"></option>
              @end
            </datalist>
          </ot-taginput>
        </label>
      </div>
    </div>

    <div class="row">
      <div class="col-12">
        <label data-field>
          Content
          <textarea name="content" rows="8"></textarea>
        </label>
      </div>
    </div>

    <div class="row">
      <div class="col-12 align-right">
        <button type="button" class="icon-link" onclick="history.back()">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/images/feather-sprite.svg#arrow-left"></use></svg>Back
        </button>
        <button type="submit">Create</button>
      </div>
    </div>
  </form>
</article>

@include('components/tag_input_script')
@end