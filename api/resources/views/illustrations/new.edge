@layout()
<div style="margin-bottom: var(--space-4);">
  <a href="/illustrations">&larr; Back to Illustrations</a>
</div>

<article class="card">
  <header>
    <h3>New Illustration</h3>
  </header>

  <form action="/illustrations" method="POST">
    <input type="hidden" name="_csrf" value="{{ csrfToken || '' }}" />
    <label data-field>
      Title
      <input type="text" name="title" required />
    </label>
    <label data-field>
      Author
      <input type="text" name="author" />
    </label>
    <label data-field>
      Source
      <input type="text" name="source" />
    </label>
    <label data-field>
      Tags
      <ot-taginput>
        <input name="tags" list="tag-list" placeholder="Add tags..." oninput="tagInputAutoComplete(this)" />
        <datalist id="tag-list">
          @each(tag in tags)
            <option value="{{ tag.name }}">
          @end
        </datalist>
      </ot-taginput>
    </label>
    <label data-field>
      Content
      <textarea name="content" rows="8"></textarea>
    </label>
    <label data-field style="flex-direction: row; align-items: center; gap: var(--space-2);">
      <input type="checkbox" name="private" id="private" style="width: auto;" />
      <span>Private/Personal illustration</span>
    </label>
    <button type="submit">Create</button>
  </form>
</article>
@include('components/tag_input_script')
@end
