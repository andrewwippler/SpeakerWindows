@layout()

<h1 class="text-2xl font-bold mb-6">Illustrations</h1>

<form
  hx-get="/illustrations"
  hx-trigger="submit"
  hx-target="#results"
  hx-swap="innerHTML"
  class="mb-6 flex gap-3"
>
  <input
    type="text"
    name="q"
    placeholder="Search illustrations..."
    value="{{ query || '' }}"
    class="flex-1 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500"
  />
  <button
    type="submit"
    class="rounded-md bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-500"
  >
    Search
  </button>
</form>

<div id="results">
  @if(flashMessages.has('error'))
    <div class="mb-4 rounded-md bg-red-50 dark:bg-red-900/30 p-4 text-sm text-red-700 dark:text-red-300">
      {{ flashMessages.get('error') }}
    </div>
  @endif

  @if(illustrations && illustrations.length)
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      @each(illustration in illustrations)
        <a
          href="/illustrations/{{ illustration.id }}"
          class="block rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4 shadow-sm hover:shadow-md transition-shadow"
        >
          @if(illustration.uploads && illustration.uploads.length)
            <div class="mb-3 aspect-video overflow-hidden rounded-md bg-gray-100 dark:bg-gray-700">
              <img
                src="/uploads/{{ illustration.uploads[0].name }}"
                alt="{{ illustration.title }}"
                class="h-full w-full object-cover"
              />
            </div>
          @endif

          <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 truncate">
            {{ illustration.title }}
          </h2>

          @if(illustration.author)
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
              {{ illustration.author }}
            </p>
          @endif

          @if(illustration.tags && illustration.tags.length)
            <div class="mt-2 flex flex-wrap gap-1">
              @each(tag in illustration.tags)
                <ot-tag>{{ tag.name }}</ot-tag>
              @end
            </div>
          @endif
        </a>
      @end
    </div>
  @else
    <p class="text-gray-500 dark:text-gray-400 text-sm">No illustrations found.</p>
  @endif
</div>
