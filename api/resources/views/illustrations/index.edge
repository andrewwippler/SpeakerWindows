@layout()

<h2>Illustrations</h2>

<form
  hx-get="/illustrations"
  hx-trigger="submit"
  hx-target="#results"
  hx-swap="innerHTML"
  style="margin-bottom: var(--space-6);"
>
  <fieldset class="group">
    <input type="text" name="q" placeholder="Search illustrations..." value="{{ search || '' }}" />
    <button type="submit">Search</button>
  </fieldset>
</form>

<div id="results">

  @if(illustrations && illustrations.length)
    <div class="container">
      <div class="row">
        @each(illustration in illustrations)
          @include('components/illustration_card')
        @end
      </div>
    </div>
  @else
    <p>No illustrations found.</p>
  @endif
</div>
@end
