@layout()

<h2>Illustrations</h2>

<form
  hx-get="/illustrations"
  hx-trigger="submit"
  hx-target="#results"
  hx-swap="innerHTML"
  style="margin-bottom: var(--space-6);"
>
  <fieldset class="group">
    <input type="text" name="q" placeholder="Search illustrations..." value="{{ search || '' }}" />
    <button type="submit">Search</button>
  </fieldset>
</form>

<div id="results">

  @if(illustrations && illustrations.length)
    <div class="container">
      <div class="row">
        @each(illustration in illustrations)
          <div class="col-4">
            <a href="/illustrations/{{ illustration.id }}" class="card">
              @if(illustration.uploads && illustration.uploads.length)
                <img
                  src="/uploads/{{ illustration.uploads[0].name }}"
                  alt="{{ illustration.title }}"
                  style="width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: var(--radius);"
                />
              @endif
              <h4>{{ illustration.title }}</h4>
              @if(illustration.author)
                <p>{{ illustration.author }}</p>
              @endif
              @if(illustration.tags && illustration.tags.length)
                <div style="display: flex; flex-wrap: wrap; gap: var(--space-1); margin-top: var(--space-2);">
                  @each(tag in illustration.tags)
                    <ot-tag>{{ tag.name }}</ot-tag>
                  @end
                </div>
              @endif
            </a>
          </div>
        @end
      </div>
    </div>
  @else
    <p>No illustrations found.</p>
  @endif
</div>
@end
