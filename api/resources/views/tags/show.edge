@layout()

<div x-data="{ selected: [], editing: false, selectable: false, allIds: {{ JSON.stringify(allIds ?? []) }} }">
  <h2>Tag: {{ tag.name }}</h2>
  <p>{{ illustrations.length }} illustration{{ illustrations.length !== 1 ? 's' : '' }}</p>

  <div style="display: flex; gap: var(--space-2); margin-bottom: var(--space-4);">
    <button type="button" data-variant="success" class=" icon-link" @click="editing = !editing">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/images/feather-sprite.svg#edit-2"></use></svg>Edit Tag
    </button>
    <button type="button" data-variant="secondary" class="icon-link" @click="selectable = !selectable; if (!selectable) selected = []">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/images/feather-sprite.svg#check-square"></use></svg>
      <span x-text="selectable ? 'Selecting...' : 'Select Illustrations'">Select Illustrations</span>
    </button>
    <form
      action="/tags/{{ tag.id }}/delete"
      method="POST"
      style="display: inline;"
      onsubmit="return confirm('Delete tag &quot;{{ tag.name }}&quot;? This will remove it from all illustrations.');"
    >
      {{ csrfField() }}
      <button type="submit" class="icon-link" data-variant="danger">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/images/feather-sprite.svg#trash-2"></use></svg>Delete Tag
      </button>
    </form>
  </div>

  <div x-cloak x-show="editing" style="margin-bottom: var(--space-4);">
    <form action="/tags/{{ tag.id }}" method="POST" class="card">
      {{ csrfField() }}
      <label data-field>
        Rename Tag
        <input type="text" name="name" value="{{ tag.name }}" required />
      </label>
      <button type="submit">Update Tag</button>
    </form>
  </div>

  @if(illustrations.length)

    <form id="bulk-form" action="/tags/{{ tag.name }}/bulk" method="POST">
      {{ csrfField() }}
      <input type="hidden" name="action" />
      <input type="hidden" name="private" />
      <template
        x-for="id in selected"
        :key="id"
      >
        <input type="hidden" name="ids[]" :value="id" />
      </template>
    </form>

    <div x-cloak x-show="selectable" style="display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-4);">
      <button
        type="button"
        class="ghost small"
        x-text="selected.length === allIds.length ? 'Clear Selection' : 'Select All'"
        @click="selected = selected.length === allIds.length ? [] : [...allIds]"
      >Select All</button>
      <button
        type="button"
        class="ghost small"
        :disabled="selected.length === 0"
        @click="document.querySelector('#bulk-form input[name=action]').value = 'remove_tag'; document.querySelector('#bulk-form').submit()"
      >Remove Illustrations</button>
      <button
        type="button"
        class="ghost small"
        :disabled="selected.length === 0"
        @click="document.querySelector('#bulk-form input[name=action]').value = 'toggle_privacy'; document.querySelector('#bulk-form input[name=private]').value = 'true'; document.querySelector('#bulk-form').submit()"
      >Make Private</button>
      <button
        type="button"
        class="ghost small"
        :disabled="selected.length === 0"
        @click="document.querySelector('#bulk-form input[name=action]').value = 'toggle_privacy'; document.querySelector('#bulk-form input[name=private]').value = 'false'; document.querySelector('#bulk-form').submit()"
      >Make Public</button>
      <span style="align-self: center;">Selected: <span x-text="selected.length">0</span></span>
    </div>

    <div class="container">
      <div class="row" style="gap: 0;">
        @each(illustration in illustrations)
          @include('components/illustration_card')
        @end
      </div>
    </div>
  @else
    <p>No illustrations with this tag yet.</p>
  @end
</div>
@end
