@layout()
<h2>Help &amp; Documentation</h2>

<p class="muted">Guides and reference documentation for using Speaker Windows.</p>

<div class="row" style="margin-top: var(--space-6);">
  <div class="col-4">
    <a href="/help/search" class="card block">
      <h3>Finding Your Illustrations</h3>
      <span class="badge" data-variant="secondary">Search &amp; Retrieval</span>
      <p class="muted">
        Use the Hybrid Search Engine to find quotes, stories, and illustrations across your titles,
        content, tags, and places &mdash; even if you cannot remember the exact wording.
      </p>
    </a>
  </div>
  <div class="col-4">
    <a href="/help/create" class="card block">
      <h3>Creating &amp; Editing Illustrations</h3>
      <span class="badge" data-variant="secondary">Media</span>
      <p class="muted">
        Create, tag, and organize illustrations &mdash; the core content units that represent quotes,
        stories, and notes for your presentations.
      </p>
    </a>
  </div>
  <div class="col-4">
    <a href="/help/import" class="card block">
      <h3>Importing Highlights from Reading Apps</h3>
      <span class="badge" data-variant="secondary">Data Sync</span>
      <p class="muted">
        Centralize notes from Kindle, KOReader, Readwise, and Google Play Books into a single
        searchable repository.
      </p>
    </a>
  </div>
</div>
@end
