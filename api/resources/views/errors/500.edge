@layout()
  <div class="flex flex-col items-center justify-center py-16">
    <svg class="h-16 w-16 text-gray-400 dark:text-gray-500 mb-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
    </svg>
    <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">500</h1>
    <p class="text-lg text-gray-500 dark:text-gray-400 mb-6">Something went wrong</p>
    <a
      href="/"
      class="rounded-md bg-sky-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-sky-500"
    >
      Back to Home
    </a>
  </div>
@end
