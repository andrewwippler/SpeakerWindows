@layout()
  <div class="flex flex-col items-center justify-center py-16">
    <svg class="h-16 w-16 text-gray-400 dark:text-gray-500 mb-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
    </svg>
    <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">404</h1>
    <p class="text-lg text-gray-500 dark:text-gray-400 mb-6">Page not found</p>
    <a
      href="/"
      class="rounded-md bg-sky-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-sky-500"
    >
      Back to Home
    </a>
  </div>
@end
