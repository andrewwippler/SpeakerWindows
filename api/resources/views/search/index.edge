@layout()
<h2>Search</h2>

<form
  hx-post="/api/search"
  hx-trigger="submit"
  hx-target="#results"
  hx-indicator="#search-spinner"
  style="margin-bottom: var(--space-6);"
>
  <fieldset class="group">
    <input type="text" name="query" placeholder="Search illustrations..." required />
    <button type="submit">Search</button>
  </fieldset>
</form>

<div id="search-spinner" class="htmx-indicator">
  Searching...
</div>

<div id="results">
  <p>Enter a search term to find illustrations.</p>
</div>
@end
