@layout()
<h2>Search</h2>

<form
  hx-post="/search"
  hx-trigger="submit"
  hx-target="#results"
  hx-swap="innerHTML"
  hx-indicator="#search-spinner"
  style="margin-bottom: var(--space-6);"
>
  <fieldset class="group">
    {{ csrfField() }}
    <input type="text" name="query" placeholder="Search illustrations..." value="{{ query || '' }}" required />
    <button type="submit">Search</button>
  </fieldset>
</form>

<div id="search-spinner" class="htmx-indicator">
  Searching...
</div>

<div id="results">
  @if(query)
    @include('search/results')
  @else
    <p>Enter a search term to find illustrations, tags, and places.</p>
  @end
</div>
@end
