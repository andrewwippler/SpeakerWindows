@layout()
<h2>Authors</h2>
@if(authors && authors.length)
<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4);">
  @each(column in columns)
  <div>
    @each(author in column)
    <div style="padding-bottom: var(--space-2);">
      <a href="/authors/{{ encodeURIComponent(author.author) }}" class="unstyled"
        style="color: var(--sky-700, inherit);">
        {{ titleCase(author.author) }}
      </a>
    </div>
    @end
  </div>
  @end
</div>
@else
<p>No authors found.</p>
@end
@end