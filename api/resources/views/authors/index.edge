@layout()
<h2>Authors</h2>
@if(authors && authors.length)
  <div class="container">
    <div class="row">
      @each(author in authors)
        <div class="col-4">
          <a href="/authors/{{ encodeURIComponent(author.author) }}" class="card">
            <figure data-variant="avatar" class="small" aria-label="{{ author.author }}">
              <abbr>{{ titleCase(author.author) }}</abbr>
            </figure>
            <h4>{{ author.author }}</h4>
          </a>
        </div>
      @end
    </div>
  </div>
@else
  <p>No authors found.</p>
@end
@end
