@layout()
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-sky-800 dark:text-sky-200">Authors</h1>
  </div>

  @if(authors && authors.length)
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      @each(author in authors)
        <a
          href="/authors/{{ author.name }}"
          class="block rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4 shadow-sm hover:shadow-md transition-shadow"
        >
          <div class="flex items-center gap-x-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-sky-100 dark:bg-sky-900">
              <span class="text-sm font-semibold text-sky-600 dark:text-sky-300">
                {{ author.name.charAt(0).toUpperCase() }}
              </span>
            </div>
            <div class="min-w-0 flex-1">
              <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100 truncate">
                {{ author.name }}
              </h2>
              @if(author.illustrationsCount)
                <p class="text-xs text-gray-500 dark:text-gray-400">
                  {{ author.illustrationsCount }} illustration{{ author.illustrationsCount !== 1 ? 's' : '' }}
                </p>
              @endif
            </div>
          </div>
        </a>
      @end
    </div>
  @else
    <p class="text-gray-500 dark:text-gray-400 text-sm">No authors found.</p>
  @endif
@end
