@layout()
<h2>Authors</h2>
@if(authors && authors.length)
  <div class="container">
    <div class="row">
      @each(author in authors)
        <div class="col-4">
          <a href="/authors/{{ author.name }}" class="card">
            <figure data-variant="avatar" class="small" aria-label="{{ author.name }}">
              <abbr>{{ titleCase(author.name) }}</abbr>
            </figure>
            <h4>{{ author.name }}</h4>
            @if(author.illustrationsCount)
              <p>{{ author.illustrationsCount }} illustration{{ author.illustrationsCount !== 1 ? 's' : '' }}</p>
            @end
          </a>
        </div>
      @end
    </div>
  </div>
@else
  <p>No authors found.</p>
@end
@end
