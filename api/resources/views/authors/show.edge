@layout()
<div style="display: flex; align-items: center; gap: var(--space-2);">
  <h2 style="margin: 0;">{{ author }}</h2>
  <button type="button" onclick="window.location.href='/authors/{{ encodeURIComponent(author) }}/edit'" data-variant="success" class="icon-link">
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <use href="/images/feather-sprite.svg#edit-2"></use>
    </svg>Edit Author
  </button>
</div>
<p>{{ illustrations.length }} illustration{{ illustrations.length !== 1 ? 's' : '' }}</p>



@if(illustrations.length)
  <div class="container" style="margin-top: var(--space-6);">
    <div class="row">
      @each(illustration in illustrations)
        @include('components/illustration_card')
      @end
    </div>
  </div>
@else
  <p>No illustrations by this author yet.</p>
@end
@end
