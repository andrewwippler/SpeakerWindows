@layout()
  <div style="display: flex; justify-content: center; padding: var(--space-8) 0;">
    <article class="card" style="width: 100%; max-width: 28rem;">
      <header>
        <h3>Change your password</h3>
      </header>

      <p>You are using a temporary password. Choose a new password before continuing.</p>

      <form method="POST" action="/change-password">
        {{ csrfField() }}
        <label data-field>
          
        Current password

          <input type="password" name="currentPassword" required autofocus />
        </label>
        <label data-field>
          
        New password

          <input
            type="password"
            name="newPassword"
            required
            minlength="8"
            pattern="^(?=.*[0-9])(?=.*[!@#$%^&*])[a-zA-Z0-9!@#$%^&*].+"
          />
        </label>
        <label data-field>
          
        Confirm new password

          <input
            type="password"
            name="newPassword_confirmation"
            required
            minlength="8"
            pattern="^(?=.*[0-9])(?=.*[!@#$%^&*])[a-zA-Z0-9!@#$%^&*].+"
          />
        </label>
        <small>Password must include a number and special character: ! @ # $ % ^ &amp; *</small>
        <button type="submit">Change Password</button>
      </form>
    </article>
  </div>
@end
