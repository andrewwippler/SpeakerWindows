@layout()
<h2>Settings</h2>

@flashMessage('success')
  <div role="alert" data-variant="success">
    {{ $message }}
  </div>
@end

@flashMessage('error')
  <div role="alert" data-variant="error">
    {{ $message }}
  </div>
@end

<ot-tabs data-anchor="settings">
  <div role="tablist">
    <button role="tab" id="tab-account">Account</button>
    <button role="tab" id="tab-defaults">Defaults</button>
    @if(team)
      <button role="tab" id="tab-team">Team</button>
    @endif
  </div>

  <div role="tabpanel" aria-labelledby="tab-account">
    <article class="card">
      <form action="/settings" method="POST">
        <input type="hidden" name="_csrf" value="{{ csrfToken || '' }}" />
        <label data-field>
          Email
          <input type="email" value="{{ auth?.user?.email || '' }}" disabled />
          <small>Email cannot be changed here.</small>
        </label>
        <label data-field>
          Illustrations
          <p>{{ illustrationsCount || 0 }} total</p>
        </label>
      </form>
    </article>
  </div>

  <div role="tabpanel" aria-labelledby="tab-defaults">
    <article class="card">
      <form action="/settings" method="POST">
        <input type="hidden" name="_csrf" value="{{ csrfToken || '' }}" />
        <label data-field>
          Default Place
          <input type="text" name="place" value="{{ settings.place || '' }}" placeholder="e.g. Home, Office" />
        </label>
        <label data-field>
          Default Location
          <input type="text" name="location" value="{{ settings.location || '' }}" placeholder="e.g. New York, NY" />
        </label>
        @if(settings.count)
          <div role="alert" data-variant="warning">
            {{ settings.count }} illustration(s) tagged "To-Fix" or "Untitled"
          </div>
        @endif
        @if(settings.emptyTags)
          <div role="alert" data-variant="warning">
            {{ settings.emptyTags }} illustration(s) with no tags
          </div>
        @endif
        <button type="submit">Save Defaults</button>
      </form>
    </article>
  </div>

  @if(team)
    <div role="tabpanel" aria-labelledby="tab-team">
      <article class="card">
        <dl>
          <div style="display: flex; justify-content: space-between;">
            <dt>Team Name</dt>
            <dd>{{ team.name }}</dd>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <dt>Members</dt>
            <dd>{{ team.membersCount || '?' }}</dd>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <dt>Role</dt>
            <dd>{{ team.role || 'Member' }}</dd>
          </div>
        </dl>
      </article>
    </div>
  @endif
</ot-tabs>
@end
